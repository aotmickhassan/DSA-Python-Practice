{
    "python.analysis.typeCheckingMode": "basic",
    // Removed duplicate key
    "window.autoDetectColorScheme": false,
    "editor.suggestOnTriggerCharacters": true, // Disable suggestions on trigger characters
    "editor.quickSuggestions": {
        "comments": "on", // Disable suggestions in comments
        "strings": "on",  // Disable suggestions in strings
        "other": "on"     // Disable suggestions elsewhere
    },
    "python.analysis.autoImportCompletions": true, // Disable auto-import completions
    // "editor.quickSuggestionsDelay": 2000, // Delay in milliseconds (2 seconds)
    "github.copilot.editor.enableAutoCompletions": false, // Disable Copilot auto-completions
    "github.copilot.enable": {
        "plaintext": false,
        "comments": "off", // Disable suggestions in comments
        "strings": "off",  // Disable suggestions in strings
        "other": "off" // Disable Copilot for plaintext files
    },
    "github.copilot.chat.codeGeneration.useInstructionFiles": false, // Disable Copilot code generation
    "github.copilot.chat.followUps": "always",
    "php-intellisense.trace.server": "off",
    "intelephense.codeLens.implementations.enable": true,

    // Enable format on save
    "editor.formatOnSave": true,

    // Use the Black formatter for PEP 8 compliance
    "python.formatting.provider": "black",

    // Optional: Set Black-specific formatting arguments
    "python.formatting.blackArgs": [
        "--line-length",
        "79" // PEP 8 recommends a maximum line length of 79 characters
    ],

    // Enable autosave after 2 seconds
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 2000 // Delay in milliseconds (2 seconds)
}